@model UsuarioViewModel
<div class="page-header">
    <div>
        <h1>@(Model.Id == 0 ? "Novo usuário" : "Editar usuário")</h1>
    </div>
</div>
<form method="post" class="content-card p-4">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Senha" class="form-label"></label>
            <input asp-for="Senha" class="form-control" />
            <small class="text-muted">@(Model.Id == 0 ? "Obrigatória no cadastro." : "Deixe em branco para manter a senha atual.")</small>
        </div>
        <div class="col-md-3">
            <label asp-for="Perfil" class="form-label"></label>
            <select asp-for="Perfil" class="form-select">
                <option>Administrador</option>
                <option>Operador</option>
            </select>
        </div>
        <div class="col-md-12 d-flex align-items-end">
            <div class="form-check">
                <input asp-for="Ativo" class="form-check-input" />
                <label asp-for="Ativo" class="form-check-label">Ativo</label>
            </div>
        </div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button class="btn btn-success btn-modern"><i class="fa-solid fa-floppy-disk"></i> Salvar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>
