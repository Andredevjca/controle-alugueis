@model FinanceiroListaViewModel
<div class="page-header">
    <div><h1>Financeiro</h1><p class="text-muted mb-0">Receitas, despesas e pagamentos</p></div>
    <div class="d-flex gap-2">
        <a class="btn btn-success btn-modern" asp-action="Criar" asp-route-tipo="Receita">Nova receita</a>
        <a class="btn btn-outline-secondary btn-modern" asp-action="Criar" asp-route-tipo="Despesa">Nova despesa</a>
    </div>
</div>
<form class="content-card p-3 mb-3" method="get">
    <div class="row g-2">
        <div class="col-md-2">
            <select name="tipo" class="form-select">
                <!option value="">Tipo</!option>
                <!option value="Receita" @(Model.Tipo == "Receita" ? "selected" : null)>Receita</!option>
                <!option value="Despesa" @(Model.Tipo == "Despesa" ? "selected" : null)>Despesa</!option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select">
                <!option value="Abertos" @(Model.Status is null or "Abertos" ? "selected" : null)>Pendentes e atrasados</!option>
                <!option value="Todos" @(Model.Status == "Todos" ? "selected" : null)>Todos</!option>
                <!option value="Pendente" @(Model.Status == "Pendente" ? "selected" : null)>Pendente</!option>
                <!option value="Atrasado" @(Model.Status == "Atrasado" ? "selected" : null)>Atrasado</!option>
                <!option value="Pago" @(Model.Status == "Pago" ? "selected" : null)>Pago</!option>
                <!option value="Cancelado" @(Model.Status == "Cancelado" ? "selected" : null)>Cancelado</!option>
            </select>
        </div>
        <div class="col-md-2"><select name="casaId" class="form-select" asp-items="Model.Casas"><option value="">Casa</option></select></div>
        <div class="col-md-2"><select name="categoriaId" class="form-select" asp-items="Model.Categorias"><option value="">Categoria</option></select></div>
        <div class="col-md-2"><input type="date" name="dataInicio" value="@(Model.DataInicio?.ToString("yyyy-MM-dd"))" class="form-control" /></div>
        <div class="col-md-2"><input type="date" name="dataFim" value="@(Model.DataFim?.ToString("yyyy-MM-dd"))" class="form-control" /></div>
        <div class="col-md-8"><input name="busca" value="@Model.Busca" class="form-control" placeholder="Buscar descrição..." /></div>
        <div class="col-md-4"><button class="btn btn-outline-secondary w-100">Filtrar</button></div>
    </div>
</form>
<div class="content-card p-3">
    <div class="table-responsive">
        <table class="table table-modern">
            <thead><tr><th>Data</th><th>Casa</th><th>Tipo</th><th>Categoria</th><th>Descrição</th><th>Vencimento</th><th>Valor</th><th>Status</th><th>Ações</th></tr></thead>
            <tbody>
            @if (!Model.Itens.Any())
            {
                <tr><td colspan="9" class="text-muted">Nenhum lançamento neste filtro. Para ver pagos, escolha Status Pago ou Todos.</td></tr>
            }
            @foreach (var item in Model.Itens)
            {
                <tr>
                    <td>@Formatador.Data(item.DataLancamento)</td>
                    <td>@(item.CasaNome ?? "-")</td>
                    <td>@item.Tipo / @item.Origem</td>
                    <td>@(item.CategoriaNome ?? "-")</td>
                    <td>@item.Descricao</td>
                    <td>@Formatador.Data(item.Vencimento)</td>
                    <td>@Formatador.Moeda(item.Valor)</td>
                    <td><span class="status-badge @Formatador.ClasseStatus(item.Status)">@item.Status</span></td>
                    <td class="text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@item.Id"><i class="bi bi-pencil"></i></a>
                        @if (item.Status is not ("Pago" or "Cancelado"))
                        {
                            <form asp-action="Pagar" asp-route-id="@item.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-sm btn-success">Pagar</button></form>
                            <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalExclusao" data-url="@Url.Action("Cancelar", new { id = item.Id })" data-mensagem="Deseja cancelar este lançamento?"><i class="bi bi-trash"></i></button>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
@{ ViewBag.Pagina = Model.Pagina; }
<partial name="_Paginacao" model="Model.TotalPaginas" />
