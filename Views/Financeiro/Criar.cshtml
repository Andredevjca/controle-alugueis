@model FinanceiroViewModel
<div class="page-header"><div><h1>@(Model.Id == 0 ? (Model.Tipo == "Despesa" ? "Nova despesa" : "Nova receita") : "Editar lançamento")</h1></div></div>
<form method="post" class="content-card p-4">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Tipo" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="CasaId" class="form-label"></label>
            <select asp-for="CasaId" asp-items="Model.Casas" class="form-select">
                <option value="">Selecione</option>
            </select>
        </div>
        <div class="col-md-4">
            <label asp-for="InquilinoId" class="form-label"></label>
            <select asp-for="InquilinoId" asp-items="Model.Inquilinos" class="form-select">
                <option value="">Selecione</option>
            </select>
        </div>
        <div class="col-md-4">
            <label asp-for="CategoriaId" class="form-label"></label>
            <select asp-for="CategoriaId" asp-items="Model.Categorias" class="form-select">
                <option value="">Selecione</option>
            </select>
        </div>
        <div class="col-md-4">
            <label asp-for="Origem" class="form-label"></label>
            <select asp-for="Origem" class="form-select">
                @if (Model.Tipo == TipoLancamento.Despesa)
                {
                    <option>Manutenção</option>
                    <option>Conserto</option>
                    <option>Imposto</option>
                    <option>Seguro</option>
                    <option>Taxa</option>
                    <option>Outros</option>
                }
                else
                {
                    <option>Aluguel</option>
                    <option>Caução</option>
                    <option>Multa</option>
                    <option>Juros</option>
                    <option>Outros</option>
                }
            </select>
        </div>
        <div class="col-md-8">
            <label asp-for="Descricao" class="form-label"></label>
            <input asp-for="Descricao" class="form-control" />
            <span asp-validation-for="Descricao" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="DataLancamento" class="form-label"></label>
            <input asp-for="DataLancamento" type="date" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="Vencimento" class="form-label"></label>
            <input asp-for="Vencimento" type="date" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="Valor" class="form-label"></label>
            <input asp-for="Valor" class="form-control" />
            <span asp-validation-for="Valor" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select">
                <option>Pendente</option>
                <option>Pago</option>
                <option>Atrasado</option>
                <option>Cancelado</option>
            </select>
        </div>
        <div class="col-md-4">
            <label asp-for="DataPagamento" class="form-label"></label>
            <input asp-for="DataPagamento" type="date" class="form-control" />
        </div>
        <div class="col-12">
            <label asp-for="Observacoes" class="form-label"></label>
            <textarea asp-for="Observacoes" class="form-control" rows="3"></textarea>
        </div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button class="btn btn-success btn-modern"><i class="bi bi-save"></i> Salvar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>
