<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Entrar") - Controle de Aluguéis</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@200..1000&amp;display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        html, body { height: 100%; margin: 0; }
        body.login-body {
            background: #f3f5f8;
            color: #1f2a37;
            font-family: var(--bs-body-font-family);
        }
        .login-wrap {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 340px 1fr;
        }
        .login-aside {
            background: #152033;
            color: #d7e0ea;
            padding: 32px 28px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .login-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(255,255,255,.08);
        }
        .login-logo {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            background: linear-gradient(135deg, #2d6a4f, #40916c);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: var(--app-brand-icon-size);
            flex-shrink: 0;
        }
        .login-brand strong { display: block; color: #fff; font-size: var(--app-font-size); }
        .login-brand small { color: #8ea0b5; font-size: var(--app-font-size); }
        .login-aside h2 {
            color: #fff;
            font-size: var(--app-title-size);
            margin: 32px 0 12px;
            font-weight: 700;
        }
        .login-aside p { color: #8ea0b5; line-height: 1.6; margin: 0 0 20px; }
        .login-features { list-style: none; padding: 0; margin: 0; }
        .login-features li {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 0;
            color: #c5d0dc;
        }
        .login-features i { color: #40916c; }
        .login-footer { color: #8ea0b5; font-size: var(--app-font-size); }
        .login-panel { display: flex; flex-direction: column; min-height: 100vh; }
        .login-topbar {
            height: 64px;
            background: #fff;
            border-bottom: 1px solid #e6ebf1;
            display: flex;
            align-items: center;
            padding: 0 24px;
        }
        .login-topbar span { display: block; color: #6b7c90; font-size: var(--app-font-size); }
        .login-main {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }
        .login-card {
            width: 100%;
            max-width: 440px;
            background: #fff;
            border-radius: var(--radius);
            padding: 28px;
            box-shadow: 0 8px 24px rgba(21, 32, 51, .08);
        }
        .login-card h3 {
            margin: 0 0 4px;
            font-size: var(--app-title-size);
            font-weight: 700;
        }
        .login-card .sub { color: #6b7c90; margin-bottom: 24px; }
        .login-card label { font-weight: 600; margin-bottom: 6px; display: block; }
        .login-card .campo {
            display: flex;
            border: 1px solid #d7e0ea;
            border-radius: 10px;
            overflow: hidden;
            background: #fff;
            margin-bottom: 4px;
        }
        .login-card .campo span {
            width: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f7f9fc;
            color: #5b6b7c;
            border-right: 1px solid #d7e0ea;
        }
        .login-card .campo input {
            flex: 1;
            border: 0;
            padding: 10px 12px;
            font-size: var(--app-font-size);
            outline: none;
            font-family: inherit;
        }
        .login-card .erro { color: #b42318; font-size: var(--app-font-size); }
        .login-check { display: flex; align-items: center; gap: 8px; margin: 16px 0 20px; }
        .login-btn {
            width: 100%;
            border: 0;
            background: #2d6a4f;
            color: #fff;
            font-weight: 600;
            border-radius: 10px;
            padding: 11px 16px;
            cursor: pointer;
            font-size: var(--app-font-size);
            font-family: inherit;
        }
        .login-btn:hover { background: #245c43; }
        .login-hint {
            margin-top: 20px;
            background: #f7f9fc;
            border-radius: 10px;
            padding: 12px 14px;
            color: #5b6b7c;
            font-size: var(--app-font-size);
        }
        @@media (max-width: 991px) {
            .login-wrap { grid-template-columns: 1fr; }
            .login-aside .login-hide { display: none; }
            .login-panel { min-height: auto; }
        }
    </style>
</head>
<body class="login-body">
    @RenderBody()
</body>
</html>
