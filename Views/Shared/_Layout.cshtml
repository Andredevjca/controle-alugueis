<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Dashboard") - Controle de Aluguéis</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@200..1000&amp;display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
            body.sidebar-collapsed .sidebar {
                width: 78px !important;
                overflow: hidden;
            }

            body.sidebar-collapsed .app-content {
                margin-left: 78px !important;
            }

            body.sidebar-collapsed .brand-text,
            body.sidebar-collapsed .menu-label,
            body.sidebar-collapsed .menu-texto {
                display: none !important;
                width: 0 !important;
                height: 0 !important;
                overflow: hidden !important;
                padding: 0 !important;
                margin: 0 !important;
            }

            body.sidebar-collapsed .sidebar-brand,
            body.sidebar-collapsed .sidebar-menu a {
                justify-content: center !important;
                padding-left: .5rem !important;
                padding-right: .5rem !important;
            }

                body.sidebar-collapsed .sidebar-menu a i {
                    font-size: var(--app-icon-size);
                    display: inline-block !important;
                }
    </style>
</head>
<body class="app-body">
    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="logo-mark"><i class="bi bi-houses"></i></div>
            <div class="brand-text">
                <strong>Controle de Aluguéis</strong>
                <small>Administração imobiliária</small>
            </div>
        </div>
        <ul class="sidebar-menu">
            <li class="menu-label">Menu principal</li>
            <li><a asp-controller="Home" asp-action="Index" title="Dashboard" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"><i class="bi bi-speedometer2"></i><span class="menu-texto">Dashboard</span></a></li>
            <li><a asp-controller="Casas" asp-action="Index" title="Casas" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Casas" ? "active" : "")"><i class="bi bi-house"></i><span class="menu-texto">Casas</span></a></li>
            <li><a asp-controller="Inquilinos" asp-action="Index" title="Inquilinos" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Inquilinos" ? "active" : "")"><i class="bi bi-people"></i><span class="menu-texto">Inquilinos</span></a></li>
            <li><a asp-controller="Contratos" asp-action="Index" title="Contratos" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Contratos" ? "active" : "")"><i class="bi bi-file-earmark-text"></i><span class="menu-texto">Contratos</span></a></li>
            <li><a asp-controller="Financeiro" asp-action="Index" title="Financeiro" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Financeiro" ? "active" : "")"><i class="bi bi-cash-stack"></i><span class="menu-texto">Financeiro</span></a></li>
            <li><a asp-controller="ContasConsumo" asp-action="Index" title="Contas (Água/Luz)" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "ContasConsumo" ? "active" : "")"><i class="bi bi-droplet"></i><span class="menu-texto">Contas (Água/Luz)</span></a></li>
            <li><a asp-controller="Observacoes" asp-action="Index" title="Observações" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Observacoes" ? "active" : "")"><i class="bi bi-chat-left-text"></i><span class="menu-texto">Observações</span></a></li>
            <li><a asp-controller="Relatorios" asp-action="Index" title="Relatórios" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Relatorios" ? "active" : "")"><i class="bi bi-bar-chart"></i><span class="menu-texto">Relatórios</span></a></li>
            <li class="menu-label">Configurações</li>
            <li><a asp-controller="Categorias" asp-action="Index" title="Categorias" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Categorias" ? "active" : "")"><i class="bi bi-tags"></i><span class="menu-texto">Categorias</span></a></li>
            <li><a asp-controller="Usuarios" asp-action="Index" title="Usuários" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Usuarios" ? "active" : "")"><i class="bi bi-person-gear"></i><span class="menu-texto">Usuários</span></a></li>
            <li><a asp-controller="Configuracoes" asp-action="Index" title="Configurações" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Configuracoes" ? "active" : "")"><i class="bi bi-gear"></i><span class="menu-texto">Configurações</span></a></li>
        </ul>
    </aside>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    <div class="app-content">
        <header class="app-header">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-outline-secondary btn-modern" id="botaoSidebar" type="button" aria-label="Recolher menu">
                    <i class="bi bi-list"></i>
                </button>
                <div>
                    <div class="text-muted small">Painel administrativo</div>
                    <strong>@(ViewData["Title"] ?? "Dashboard")</strong>
                </div>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="dropdown">
                    <button class="btn btn-light btn-modern" data-bs-toggle="dropdown">
                        <i class="bi bi-bell"></i>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 260px;">
                        <strong>Notificações</strong>
                        <p class="small text-muted mb-0 mt-2">Acompanhe vencimentos e aluguéis atrasados no dashboard.</p>
                    </div>
                </div>
                <div class="dropdown">
                    <button class="btn btn-light btn-modern d-flex align-items-center gap-2" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle"></i>
                        <span>@User.Identity?.Name</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-controller="Configuracoes" asp-action="Index"><i class="bi bi-gear me-2"></i>Configurações</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" asp-controller="Conta" asp-action="Sair"><i class="bi bi-box-arrow-right me-2"></i>Sair</a></li>
                    </ul>
                </div>
            </div>
        </header>
        <main class="app-main" id="app-page" tabindex="-1">
            @if (TempData["Sucesso"] is string sucesso)
            {
                <div class="alert alert-success">@sucesso</div>
            }
            @if (TempData["Erro"] is string erro)
            {
                <div class="alert alert-danger">@erro</div>
            }
            @RenderBody()
        </main>
    </div>

    <div class="modal fade" id="modalExclusao" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar exclusão</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p data-mensagem-exclusao>Tem certeza que deseja excluir este registro?</p>
                </div>
                <div class="modal-footer">
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Excluir</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/util.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/contratos.js" asp-append-version="true"></script>
    <script src="~/js/contasconsumo.js" asp-append-version="true"></script>
    <script src="~/js/navigation.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
