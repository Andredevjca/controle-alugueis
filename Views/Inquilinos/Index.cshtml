@model InquilinoListaViewModel
<div class="page-header">
    <div><h1>Inquilinos</h1><p class="text-muted mb-0">Cadastro de moradores</p></div>
    <a class="btn btn-success btn-modern" asp-action="Criar"><i class="bi bi-plus-lg"></i> Novo inquilino</a>
</div>
<form class="content-card p-3 mb-3" method="get">
    <div class="input-group">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input name="busca" value="@Model.Busca" class="form-control" placeholder="Nome, CPF, e-mail..." />
        <button class="btn btn-outline-secondary">Buscar</button>
    </div>
</form>
<div class="content-card p-3">
    <div class="table-responsive">
        <table class="table table-modern">
            <thead><tr><th>Nome</th><th>CPF</th><th>Telefone</th><th>WhatsApp</th><th>E-mail</th><th>Situação</th><th>Ações</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Itens)
            {
                <tr>
                    <td>@item.NomeCompleto</td>
                    <td>@item.Cpf</td>
                    <td>@item.Telefone</td>
                    <td>@item.Whatsapp</td>
                    <td>@item.Email</td>
                    <td><span class="status-badge @Formatador.ClasseStatus(item.Situacao == "Alugando" ? StatusCasa.Alugada : StatusCasa.Disponivel)">@item.Situacao</span></td>
                    <td class="text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Detalhes" asp-route-id="@item.Id"><i class="bi bi-eye"></i></a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@item.Id"><i class="bi bi-pencil"></i></a>
                        <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalExclusao" data-url="@Url.Action("Excluir", new { id = item.Id })"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
@{ ViewBag.Pagina = Model.Pagina; }
<partial name="_Paginacao" model="Model.TotalPaginas" />
