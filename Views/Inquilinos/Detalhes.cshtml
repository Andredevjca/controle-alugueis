@model InquilinoDetalhesViewModel
<div class="page-header">
    <div>
        <h1>@Model.Inquilino.NomeCompleto</h1>
        <p class="text-muted mb-0">@Model.Inquilino.Cpf · @Model.Inquilino.Email</p>
    </div>
    <a class="btn btn-outline-secondary btn-modern" asp-action="Editar" asp-route-id="@Model.Inquilino.Id"><i class="bi bi-pencil"></i> Editar</a>
</div>
<div class="row g-3 mb-3">
    <div class="col-lg-6">
        <div class="content-card p-3">
            <h2 class="h6">Dados pessoais</h2>
            <p class="mb-1">RG: @(Model.Inquilino.Rg ?? "-")</p>
            <p class="mb-1">Nascimento: @Formatador.Data(Model.Inquilino.DataNascimento)</p>
            <p class="mb-1">Telefone: @(Model.Inquilino.Telefone ?? "-")</p>
            <p class="mb-1">WhatsApp: @(Model.Inquilino.Whatsapp ?? "-")</p>
            <p class="mb-1">Profissão: @(Model.Inquilino.Profissao ?? "-")</p>
            <p class="mb-0">Renda: @Formatador.Moeda(Model.Inquilino.Renda)</p>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="content-card p-3">
            <h2 class="h6">Contrato atual</h2>
            @if (Model.ContratoAtual == null)
            {
                <p class="mb-0">Sem contrato ativo.</p>
            }
            else
            {
                <p class="mb-1">Casa: <strong>@Model.CasaAtual?.Nome</strong></p>
                <p class="mb-1">Contrato: @Model.ContratoAtual.Numero</p>
                <p class="mb-1">Entrada: @Formatador.Data(Model.ContratoAtual.DataInicio)</p>
                <p class="mb-0">Tempo de residência: <strong>@Model.TempoResidencia</strong></p>
            }
        </div>
    </div>
</div>
<div class="content-card p-3 mb-3">
    <h2 class="h6">Histórico de contratos e casas</h2>
    <div class="table-responsive">
        <table class="table table-modern">
            <thead><tr><th>Casa</th><th>Contrato</th><th>Entrada</th><th>Saída</th><th>Aluguel</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var h in Model.HistoricoContratos)
                {
                    <tr>
                        <td>@h.NomeInquilino</td>
                        <td>@h.NumeroContrato</td>
                        <td>@Formatador.Data(h.DataEntrada)</td>
                        <td>@Formatador.Data(h.DataSaida)</td>
                        <td>@Formatador.Moeda(h.ValorAluguel)</td>
                        <td><span class="status-badge @Formatador.ClasseStatus(h.Status)">@h.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<div class="content-card p-3 mb-3">
    <h2 class="h6">Histórico financeiro</h2>
    <div class="table-responsive">
        <table class="table table-modern">
            <thead><tr><th>Descrição</th><th>Vencimento</th><th>Valor</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var l in Model.HistoricoFinanceiro)
                {
                    <tr>
                        <td>@l.Descricao</td>
                        <td>@Formatador.Data(l.Vencimento)</td>
                        <td>@Formatador.Moeda(l.Valor)</td>
                        <td><span class="status-badge @Formatador.ClasseStatus(l.Status)">@l.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<div class="timeline">
    @foreach (var o in Model.Observacoes)
    {
        <div class="timeline-item">
            <div class="content-card p-3">
                <strong>@o.Titulo</strong>
                <p class="mb-1">@o.Descricao</p>
                <small class="text-muted">@Formatador.DataHora(o.DataObservacao) · @o.Tipo</small>
            </div>
        </div>
    }
</div>
