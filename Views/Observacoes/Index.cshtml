@model ObservacaoListaViewModel
<div class="page-header">
    <div>
        <h1>Observações</h1>
        <p class="text-muted mb-0">Registros de casas, contratos, inquilinos e manutenções</p>
    </div>
    <a class="btn btn-success btn-modern" asp-action="Criar"><i class="fa-solid fa-plus"></i> Nova observação</a>
</div>
<form class="content-card p-3 mb-3" method="get">
    <div class="row g-2">
        <div class="col-md-3">
            <select name="tipo" class="form-select">
                <option value="">Tipo</option>
                <option>Casa</option>
                <option>Contrato</option>
                <option>Inquilino</option>
                <option>Financeiro</option>
                <option>Água</option>
                <option>Luz</option>
                <option>Manutenção</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="casaId" class="form-select" asp-items="Model.Casas">
                <option value="">Casa</option>
            </select>
        </div>
        <div class="col-md-4"><input name="busca" value="@Model.Busca" class="form-control" placeholder="Buscar título ou descrição" /></div>
        <div class="col-md-2"><button class="btn btn-outline-secondary w-100">Filtrar</button></div>
    </div>
</form>
<div class="timeline">
    @foreach (var item in Model.Itens)
    {
        <div class="timeline-item">
            <div class="content-card p-3">
                <div class="d-flex justify-content-between gap-2">
                    <div>
                        <strong>@item.Titulo</strong>
                        <div class="small text-muted">@(item.CasaNome ?? "Sem casa") · @Formatador.DataHora(item.DataObservacao)</div>
                    </div>
                    <span class="status-badge status-info">@item.Tipo</span>
                </div>
                <p class="mt-2 mb-2">@item.Descricao</p>
                <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalExclusao" data-url="@Url.Action("Excluir", new { id = item.Id })"><i class="fa-solid fa-trash-can"></i></button>
            </div>
        </div>
    }
    @if (!Model.Itens.Any())
    {
        <p class="text-muted">Nenhuma observação cadastrada.</p>
    }
</div>
