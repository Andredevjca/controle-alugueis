@model CasaDetalhesViewModel
@{
    var casa = Model.Casa;
}
<div class="page-header">
    <div>
        <h1>@casa.Nome</h1>
        <p class="text-muted mb-0">@casa.Endereco, @casa.Numero - @casa.Bairro, @casa.Cidade/@casa.Estado</p>
    </div>
    <div class="d-flex gap-2">
        <span class="status-badge @Formatador.ClasseStatus(casa.Status) align-self-center">@casa.Status</span>
        <a class="btn btn-outline-secondary btn-modern" asp-action="Editar" asp-route-id="@casa.Id"><i class="bi bi-pencil"></i> Editar</a>
    </div>
</div>
<nav aria-label="Seções da casa" class="casa-tabs mb-3">
    <ul class="nav">
        <li class="nav-item"><a class="nav-link @(Model.Aba == "resumo" ? "active" : "")" asp-action="Detalhes" asp-route-id="@casa.Id" asp-route-aba="resumo" aria-current="@(Model.Aba == "resumo" ? "page" : null)"><i class="bi bi-house" aria-hidden="true"></i> Resumo</a></li>
        <li class="nav-item"><a class="nav-link @(Model.Aba == "contrato" ? "active" : "")" asp-action="Detalhes" asp-route-id="@casa.Id" asp-route-aba="contrato" aria-current="@(Model.Aba == "contrato" ? "page" : null)"><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Contrato</a></li>
        <li class="nav-item"><a class="nav-link @(Model.Aba == "financeiro" ? "active" : "")" asp-action="Detalhes" asp-route-id="@casa.Id" asp-route-aba="financeiro" aria-current="@(Model.Aba == "financeiro" ? "page" : null)"><i class="bi bi-cash-stack" aria-hidden="true"></i> Financeiro</a></li>
        <li class="nav-item"><a class="nav-link @(Model.Aba == "consumo" ? "active" : "")" asp-action="Detalhes" asp-route-id="@casa.Id" asp-route-aba="consumo" aria-current="@(Model.Aba == "consumo" ? "page" : null)"><i class="bi bi-lightning-charge" aria-hidden="true"></i> Água/Luz</a></li>
        <li class="nav-item"><a class="nav-link @(Model.Aba == "observacoes" ? "active" : "")" asp-action="Detalhes" asp-route-id="@casa.Id" asp-route-aba="observacoes" aria-current="@(Model.Aba == "observacoes" ? "page" : null)"><i class="bi bi-chat-left-text" aria-hidden="true"></i> Observações</a></li>
        <li class="nav-item"><a class="nav-link @(Model.Aba == "historico" ? "active" : "")" asp-action="Detalhes" asp-route-id="@casa.Id" asp-route-aba="historico" aria-current="@(Model.Aba == "historico" ? "page" : null)"><i class="bi bi-clock-history" aria-hidden="true"></i> Histórico</a></li>
    </ul>
</nav>

@if (Model.Aba == "resumo")
{
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="content-card p-3 h-100">
                <h2 class="h6">Informações da casa</h2>
                <p class="mb-1">Área: @(casa.AreaM2?.ToString("N2") ?? "-") m²</p>
                <p class="mb-1">Quartos: @casa.QtdQuartos · Banheiros: @casa.QtdBanheiros · Vagas: @casa.QtdVagas</p>
                <p class="mb-1">Valor do aluguel: <strong>@Formatador.Moeda(casa.ValorAluguel)</strong></p>
                <p class="mb-0">Dia do vencimento: @casa.DiaVencimento</p>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="content-card p-3 h-100">
                <h2 class="h6">Contrato e inquilino atuais</h2>
                @if (Model.ContratoAtual == null)
                {
                    <p class="mb-2">Casa disponível. Nenhum contrato ativo.</p>
                    <a class="btn btn-success btn-sm btn-modern" asp-controller="Contratos" asp-action="Criar" asp-route-casaId="@casa.Id">Novo contrato</a>
                }
                else
                {
                    <p class="mb-1">Inquilino: <strong>@Model.InquilinoAtual?.NomeCompleto</strong></p>
                    <p class="mb-1">Contrato: @Model.ContratoAtual.Numero</p>
                    <p class="mb-1">Entrada: @Formatador.Data(Model.ContratoAtual.DataInicio)</p>
                    <p class="mb-1">Tempo de residência: <strong>@Model.TempoResidencia</strong></p>
                    <p class="mb-1">Próximo vencimento: @Formatador.Data(Model.ProximoVencimento)</p>
                    <p class="mb-0">Situação financeira: <span class="status-badge @Formatador.ClasseStatus(Model.SituacaoFinanceira)">@Model.SituacaoFinanceira</span></p>
                }
            </div>
        </div>
    </div>
}

@if (Model.Aba == "contrato")
{
    <div class="content-card p-3">
        @if (Model.ContratoAtual == null)
        {
            <p>Não há contrato ativo.</p>
            <a class="btn btn-success btn-modern" asp-controller="Contratos" asp-action="Criar" asp-route-casaId="@casa.Id">Cadastrar contrato</a>
        }
        else
        {
            var c = Model.ContratoAtual;
            <div class="row g-3">
                <div class="col-md-4">
                    <strong>Número</strong>
                    <div>@c.Numero</div>
                </div>
                <div class="col-md-4">
                    <strong>Inquilino</strong>
                    <div>@c.InquilinoNome</div>
                </div>
                <div class="col-md-4">
                    <strong>Status</strong>
                    <div><span class="status-badge @Formatador.ClasseStatus(c.Status)">@c.Status</span></div>
                </div>
                <div class="col-md-4">
                    <strong>Início</strong>
                    <div>@Formatador.Data(c.DataInicio)</div>
                </div>
                <div class="col-md-4">
                    <strong>Término previsto</strong>
                    <div>@Formatador.Data(c.DataTermino)</div>
                </div>
                <div class="col-md-4">
                    <strong>Aluguel</strong>
                    <div>@Formatador.Moeda(c.ValorAluguel)</div>
                </div>
                <div class="col-md-4">
                    <strong>Caução</strong>
                    <div>@Formatador.Moeda(c.ValorCaucao) (@c.MesesCaucao mês/meses)</div>
                </div>
                <div class="col-md-4">
                    <strong>Multa / Juros</strong>
                    <div>@c.PercentualMulta% / @c.PercentualJuros%</div>
                </div>
                <div class="col-md-4">
                    <strong>Índice</strong>
                    <div>@(c.IndiceReajuste ?? "-")</div>
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <a class="btn btn-outline-secondary btn-modern" asp-controller="Contratos" asp-action="Detalhes" asp-route-id="@c.Id">Visualizar contrato</a>
                <a class="btn btn-outline-danger btn-modern" asp-controller="Contratos" asp-action="Encerrar" asp-route-id="@c.Id">Encerrar contrato</a>
            </div>
        }
    </div>
}

@if (Model.Aba == "financeiro")
{
    <div class="d-flex gap-2 mb-3">
        <a class="btn btn-success btn-modern" asp-controller="Financeiro" asp-action="Criar" asp-route-tipo="Receita" asp-route-casaId="@casa.Id">Registrar receita</a>
        <a class="btn btn-outline-secondary btn-modern" asp-controller="Financeiro" asp-action="Criar" asp-route-tipo="Despesa" asp-route-casaId="@casa.Id">Registrar despesa</a>
    </div>
    <div class="content-card p-3">
        <div class="table-responsive">
            <table class="table table-modern">
                <thead><tr><th>Data</th><th>Tipo</th><th>Descrição</th><th>Vencimento</th><th>Valor</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var l in Model.Lancamentos)
                    {
                        <tr>
                            <td>@Formatador.Data(l.DataLancamento)</td>
                            <td>@l.Tipo / @l.Origem</td>
                            <td>@l.Descricao</td>
                            <td>@Formatador.Data(l.Vencimento)</td>
                            <td>@Formatador.Moeda(l.Valor)</td>
                            <td><span class="status-badge @Formatador.ClasseStatus(l.Status)">@l.Status</span></td>
                            <td>
                                @if (l.Status != StatusFinanceiro.Pago && l.Status != StatusFinanceiro.Cancelado)
                                {
                                    <form asp-controller="Financeiro" asp-action="Pagar" asp-route-id="@l.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path?aba=financeiro" />
                                        <button class="btn btn-sm btn-success">Registrar pagamento</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.Aba == "consumo")
{
    <div class="d-flex gap-2 mb-3">
        <a class="btn btn-success btn-modern" asp-controller="ContasConsumo" asp-action="Criar" asp-route-tipo="@TipoConsumo.Agua" asp-route-casaId="@casa.Id"><i class="bi bi-droplet"></i> Água</a>
        <a class="btn btn-outline-secondary btn-modern" asp-controller="ContasConsumo" asp-action="Criar" asp-route-tipo="@TipoConsumo.Luz" asp-route-casaId="@casa.Id"><i class="bi bi-lightning"></i> Luz</a>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="summary-card p-3">
                <h3 class="h6">Água</h3>
                <p class="mb-1">Média de consumo: @Model.MediaConsumoAgua.ToString("N2")</p>
                <p class="mb-1">Média de valor: @Formatador.Moeda(Model.MediaValorAgua)</p>
                <p class="mb-0">Última conta: @(Model.UltimaAgua == null ? "-" : $"{Model.UltimaAgua.Referencia} · {Formatador.Moeda(Model.UltimaAgua.Valor)}")</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="summary-card p-3">
                <h3 class="h6">Luz</h3>
                <p class="mb-1">Média de consumo: @Model.MediaConsumoLuz.ToString("N2")</p>
                <p class="mb-1">Média de valor: @Formatador.Moeda(Model.MediaValorLuz)</p>
                <p class="mb-0">Última conta: @(Model.UltimaLuz == null ? "-" : $"{Model.UltimaLuz.Referencia} · {Formatador.Moeda(Model.UltimaLuz.Valor)}")</p>
            </div>
        </div>
    </div>
    <div class="content-card p-3">
        <h3 class="h6">Água</h3>
        <div class="table-responsive mb-4">
            <table class="table table-modern">
                <thead><tr><th>Referência</th><th>Anterior</th><th>Atual</th><th>Consumo</th><th>Valor</th><th>Vencimento</th><th>Pagamento</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var c in Model.ContasAgua)
                    {
                        <tr>
                            <td>@c.Referencia</td>
                            <td>@c.LeituraAnterior</td>
                            <td>@c.LeituraAtual</td>
                            <td>@c.Consumo</td>
                            <td>@Formatador.Moeda(c.Valor)</td>
                            <td>@Formatador.Data(c.Vencimento)</td>
                            <td>@Formatador.Data(c.DataPagamento)</td>
                            <td><span class="status-badge @Formatador.ClasseStatus(c.Status)">@c.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <h3 class="h6">Luz</h3>
        <div class="table-responsive">
            <table class="table table-modern">
                <thead><tr><th>Referência</th><th>Anterior</th><th>Atual</th><th>Consumo</th><th>Valor</th><th>Vencimento</th><th>Pagamento</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var c in Model.ContasLuz)
                    {
                        <tr>
                            <td>@c.Referencia</td>
                            <td>@c.LeituraAnterior</td>
                            <td>@c.LeituraAtual</td>
                            <td>@c.Consumo</td>
                            <td>@Formatador.Moeda(c.Valor)</td>
                            <td>@Formatador.Data(c.Vencimento)</td>
                            <td>@Formatador.Data(c.DataPagamento)</td>
                            <td><span class="status-badge @Formatador.ClasseStatus(c.Status)">@c.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.Aba == "observacoes")
{
    <a class="btn btn-success btn-modern mb-3" asp-controller="Observacoes" asp-action="Criar" asp-route-casaId="@casa.Id">Nova observação</a>
    <div class="timeline">
        @foreach (var o in Model.Observacoes)
        {
            <div class="timeline-item">
                <div class="content-card p-3">
                    <div class="d-flex justify-content-between"><strong>@o.Titulo</strong><span class="status-badge status-info">@o.Tipo</span></div>
                    <p class="mb-1">@o.Descricao</p>
                    <small class="text-muted">@Formatador.DataHora(o.DataObservacao)</small>
                </div>
            </div>
        }
    </div>
}

@if (Model.Aba == "historico")
{
    <h2 class="h5 mb-3">Histórico de inquilinos</h2>
    <p class="text-muted">O histórico nunca é apagado quando um contrato é encerrado.</p>
    <div class="timeline">
        @foreach (var h in Model.Historico)
        {
            <div class="timeline-item @(h.Atual ? "" : "encerrado")">
                <div class="content-card p-3">
                    <div class="d-flex justify-content-between">
                        <h3 class="h6 mb-1">@h.NomeInquilino</h3>
                        <span class="status-badge @Formatador.ClasseStatus(h.Atual ? "Alugada" : h.Status)">@(h.Atual ? "Atual" : h.Status)</span>
                    </div>
                    <p class="mb-1">Entrada: @Formatador.Data(h.DataEntrada)</p>
                    @if (h.DataSaida.HasValue)
                    {
                        <p class="mb-1">Saída: @Formatador.Data(h.DataSaida)</p>
                    }
                    <p class="mb-1">Contrato: @h.NumeroContrato</p>
                    <p class="mb-1">Aluguel: @Formatador.Moeda(h.ValorAluguel)</p>
                    <p class="mb-2 small text-muted">Tempo: @h.TempoResidencia</p>
                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Inquilinos" asp-action="Detalhes" asp-route-id="@h.InquilinoId">Visualizar inquilino</a>
                </div>
            </div>
        }
    </div>
}
