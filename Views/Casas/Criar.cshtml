@model CasaViewModel
<div class="page-header">
    <div>
        <h1>@(Model.Id == 0 ? "Nova casa" : "Editar casa")</h1>
        <p class="text-muted mb-0">Informações do imóvel</p>
    </div>
</div>
<form method="post" class="content-card p-4">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Nome" class="form-label"></label>
            <input asp-for="Nome" class="form-control" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Cep" class="form-label"></label>
            <input asp-for="Cep" class="form-control" data-mascara="cep" />
        </div>
        <div class="col-md-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select">
                <option>@StatusCasa.Disponivel</option>
                <option>@StatusCasa.Alugada</option>
                <option>@StatusCasa.Manutencao</option>
            </select>
        </div>
        <div class="col-md-6">
            <label asp-for="Endereco" class="form-label"></label>
            <input asp-for="Endereco" class="form-control" />
            <span asp-validation-for="Endereco" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Numero" class="form-label"></label>
            <input asp-for="Numero" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Complemento" class="form-label"></label>
            <input asp-for="Complemento" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Bairro" class="form-label"></label>
            <input asp-for="Bairro" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Cidade" class="form-label"></label>
            <input asp-for="Cidade" class="form-control" />
            <span asp-validation-for="Cidade" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Estado" class="form-label"></label>
            <input asp-for="Estado" class="form-control" maxlength="2" />
            <span asp-validation-for="Estado" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="ValorAluguel" class="form-label"></label>
            <input asp-for="ValorAluguel" class="form-control" />
            <span asp-validation-for="ValorAluguel" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="DiaVencimento" class="form-label"></label>
            <input asp-for="DiaVencimento" class="form-control" />
            <span asp-validation-for="DiaVencimento" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="AreaM2" class="form-label"></label>
            <input asp-for="AreaM2" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="QtdQuartos" class="form-label"></label>
            <input asp-for="QtdQuartos" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="QtdBanheiros" class="form-label"></label>
            <input asp-for="QtdBanheiros" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="QtdVagas" class="form-label"></label>
            <input asp-for="QtdVagas" class="form-control" />
        </div>
        <div class="col-12">
            <label asp-for="Observacoes" class="form-label"></label>
            <textarea asp-for="Observacoes" class="form-control" rows="3"></textarea>
        </div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button class="btn btn-success btn-modern"><i class="bi bi-save"></i> Salvar</button>
        <a class="btn btn-outline-secondary btn-modern" asp-action="Index">Cancelar</a>
    </div>
</form>
