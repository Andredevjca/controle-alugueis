@model Contrato
<div class="page-header">
    <div>
        <h1>Contrato @Model.Numero</h1>
        <p class="text-muted mb-0">@Model.CasaNome · @Model.InquilinoNome</p>
    </div>
    <span class="status-badge @Formatador.ClasseStatus(Model.Status)">@Model.Status</span>
</div>
<div class="content-card p-4">
    <div class="row g-3">
        <div class="col-md-4"><strong>Início</strong><div>@Formatador.Data(Model.DataInicio)</div></div>
        <div class="col-md-4"><strong>Término previsto</strong><div>@Formatador.Data(Model.DataTermino)</div></div>
        <div class="col-md-4"><strong>Data de saída</strong><div>@Formatador.Data(Model.DataFim)</div></div>
        <div class="col-md-4"><strong>Aluguel</strong><div>@Formatador.Moeda(Model.ValorAluguel)</div></div>
        <div class="col-md-4"><strong>Dia vencimento</strong><div>@Model.DiaVencimento</div></div>
        <div class="col-md-4"><strong>Caução</strong><div>@Formatador.Moeda(Model.ValorCaucao)</div></div>
        <div class="col-12"><strong>Observações</strong><div>@(Model.Observacoes ?? "-")</div></div>
    </div>
    @if (Model.Status == StatusContrato.Ativo)
    {
        <div class="mt-3 d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-action="Editar" asp-route-id="@Model.Id">Editar</a>
            <a class="btn btn-outline-danger" asp-action="Encerrar" asp-route-id="@Model.Id">Encerrar</a>
        </div>
    }
</div>
