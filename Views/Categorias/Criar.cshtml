@model CategoriaViewModel
<div class="page-header"><div><h1>Nova categoria</h1></div></div>
<form method="post" class="content-card p-4">
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Nome" class="form-label"></label>
            <input asp-for="Nome" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Tipo" class="form-label"></label>
            <select asp-for="Tipo" class="form-select">
                <option>Receita</option>
                <option>Despesa</option>
            </select>
        </div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button class="btn btn-success btn-modern"><i class="fa-solid fa-floppy-disk"></i> Salvar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>
