@model DashboardViewModel
@if (ViewBag.ErroBanco is string erroBanco)
{
    <div class="alert alert-warning">@erroBanco</div>
}
<div class="page-header">
    <div>
        <h1>Dashboard</h1>
        <p class="text-muted mb-0">Visão geral da operação imobiliária</p>
    </div>
</div>
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="card-dashboard d-flex justify-content-between">
            <div><div class="label">Total de casas</div><div class="value">@Model.TotalCasas</div></div>
            <div class="icon-wrap bg-soft-blue"><i class="bi bi-house"></i></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card-dashboard d-flex justify-content-between">
            <div><div class="label">Casas alugadas</div><div class="value">@Model.CasasAlugadas</div></div>
            <div class="icon-wrap bg-soft-green"><i class="bi bi-house-check"></i></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card-dashboard d-flex justify-content-between">
            <div><div class="label">Casas disponíveis</div><div class="value">@Model.CasasDisponiveis</div></div>
            <div class="icon-wrap bg-soft-blue"><i class="bi bi-house-dash"></i></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card-dashboard d-flex justify-content-between">
            <div><div class="label">Total a receber no mês</div><div class="value">@Formatador.Moeda(Model.TotalReceberMes)</div></div>
            <div class="icon-wrap bg-soft-green"><i class="bi bi-cash-stack"></i></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card-dashboard d-flex justify-content-between">
            <div><div class="label">Aluguéis atrasados</div><div class="value">@Model.QtdAlugueisAtrasados</div><small class="text-danger">@Formatador.Moeda(Model.TotalAtrasado)</small></div>
            <div class="icon-wrap bg-soft-red"><i class="bi bi-exclamation-triangle"></i></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card-dashboard d-flex justify-content-between">
            <div><div class="label">Despesas do mês</div><div class="value">@Formatador.Moeda(Model.DespesasMes)</div></div>
            <div class="icon-wrap bg-soft-yellow"><i class="bi bi-receipt"></i></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card-dashboard d-flex justify-content-between">
            <div><div class="label">Receitas do mês</div><div class="value">@Formatador.Moeda(Model.ReceitasMes)</div></div>
            <div class="icon-wrap bg-soft-purple"><i class="bi bi-graph-up-arrow"></i></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card-dashboard d-flex justify-content-between">
            <div><div class="label">Saldo do mês</div><div class="value">@Formatador.Moeda(Model.SaldoMes)</div></div>
            <div class="icon-wrap bg-soft-green"><i class="bi bi-wallet2"></i></div>
        </div>
    </div>
</div>

<h2 class="h5 mb-3">Situação das casas</h2>
<div class="row g-3 mb-4">
    @foreach (var casa in Model.Casas)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card-imovel">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <h3>@casa.Nome</h3>
                        <div class="text-muted small">@casa.Endereco</div>
                    </div>
                    <span class="status-badge @Formatador.ClasseStatus(casa.Status)">@casa.Status</span>
                </div>
                <p class="mb-1"><i class="bi bi-person"></i> @(casa.InquilinoAtual ?? "Sem inquilino")</p>
                <p class="mb-1"><strong>@Formatador.Moeda(casa.ValorAluguel)</strong></p>
                <p class="mb-2 text-muted small">Vencimento: dia @casa.DiaVencimento</p>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="status-badge @Formatador.ClasseStatus(casa.SituacaoFinanceira)">@casa.SituacaoFinanceira</span>
                    <a class="btn btn-sm btn-outline-success btn-modern" asp-controller="Casas" asp-action="Detalhes" asp-route-id="@casa.Id"><i class="bi bi-eye"></i> Visualizar</a>
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-3">
    <div class="col-xl-8">
        <div class="content-card p-3">
            <h2 class="h5 mb-3">Próximos vencimentos</h2>
            <div class="table-responsive">
                <table class="table table-modern align-middle">
                    <thead>
                        <tr>
                            <th>Casa</th>
                            <th>Inquilino</th>
                            <th>Tipo</th>
                            <th>Vencimento</th>
                            <th>Valor</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ProximosVencimentos)
                        {
                            <tr>
                                <td>@item.Casa</td>
                                <td>@item.Inquilino</td>
                                <td>@item.Tipo</td>
                                <td>@Formatador.Data(item.Vencimento)</td>
                                <td>@Formatador.Moeda(item.Valor)</td>
                                <td><span class="status-badge @Formatador.ClasseStatus(item.Status)">@item.Status</span></td>
                            </tr>
                        }
                        @if (!Model.ProximosVencimentos.Any())
                        {
                            <tr><td colspan="6" class="text-muted">Nenhum vencimento próximo.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="content-card p-3 mb-3">
            <h2 class="h5">Resumo financeiro</h2>
            <div class="d-flex justify-content-between py-2 border-bottom">
                <span>Receitas</span>
                <strong>@Formatador.Moeda(Model.ReceitasMes)</strong>
            </div>
            <div class="d-flex justify-content-between py-2 border-bottom">
                <span>Despesas</span>
                <strong>@Formatador.Moeda(Model.DespesasMes)</strong>
            </div>
            <div class="d-flex justify-content-between py-2">
                <span>Saldo</span>
                <strong>@Formatador.Moeda(Model.SaldoMes)</strong>
            </div>
        </div>
        <div class="content-card p-3">
            <h2 class="h5">Contratos próximos do vencimento</h2>
            @foreach (var contrato in Model.ContratosProximosVencimento)
            {
                <div class="border-bottom py-2">
                    <strong>@contrato.Numero</strong> · @contrato.CasaNome
                    <div class="small text-muted">@contrato.InquilinoNome · @Formatador.Data(contrato.DataTermino)</div>
                </div>
            }
            @if (!Model.ContratosProximosVencimento.Any())
            {
                <p class="text-muted mb-0">Nenhum contrato vencendo nos próximos 60 dias.</p>
            }
        </div>
    </div>
</div>
