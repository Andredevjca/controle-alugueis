@model ConfiguracaoViewModel
<div class="page-header">
    <div>
        <h1>Configurações</h1>
        <p class="text-muted mb-0">Parâmetros gerais do sistema</p>
    </div>
</div>
<div class="content-card p-3">
    @foreach (var item in Model.Itens)
    {
        <form method="post" class="row g-2 align-items-end border-bottom py-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@item.Id" />
            <div class="col-md-3">
                <label class="form-label">Chave</label>
                <input class="form-control" value="@item.Chave" disabled />
            </div>
            <div class="col-md-5">
                <label class="form-label">Valor</label>
                <input name="valor" class="form-control" value="@item.Valor" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Descrição</label>
                <div class="form-control-plaintext">@(item.Descricao ?? "-")</div>
            </div>
            <div class="col-md-1">
                <button class="btn btn-success btn-modern w-100"><i class="fa-solid fa-floppy-disk"></i> Salvar</button>
            </div>
        </form>
    }
</div>
